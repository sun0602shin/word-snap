re"],"뚝뚝떨어지다":["dribble"],"뚫고나가게하다":["navigate","reeve"],"뚫고들어갈수없는":["impenetrable"],"뚫고지나가다":["cut"],"뚫어지게보다":["scrutinize"],"뚱땅거리며마시는":["roisterous"],"뛰어돌아다니다":["prance","wanton"],"뛰어돌아다님":["frisk"],"뛰어오르게하다":["jump","jumper"],"뛰어나인기배우":["superstar"],"뛰어넘는사람":["vaulter"],"뜨개눈의가로줄":["course"],"뜬찌끼투성이의":["scummy"],"뜸부기과의새":["limpkin"],"띠모양의것이있는":["cingulate"],"띠로이은지붕":["thatch"],"띠만드는사람":["girdler"],"띠모양의장식":["frieze"]}