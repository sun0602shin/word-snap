ure"],"지배당하지않은":["ungoverned","unruled"],"지배할수있는":["governable","rulable"],"지부설립허가":["charter"],"지불되지않은":["unpaid"],"지불액사정원":["claimsman"],"지붕밑의칸막이":["ashlaring"],"지붕이는데쓰는":["roofing"],"지붕이는사람":["roofer","slater"],"지붕이는슬레이트":["rag"],"지붕있는짐마차":["cariole"],"지붕있는통로":["breezeway"],"지붕널모양의":["shingly"],"지붕모양의물건":["roof"],"지붕없는관람석":["bleacher"],"지붕으로덮다":["roof"],"지붕을접을수있는":["convertible","softtop"],"지빠귀과의일종":["bluebird"],"지빠귀류의새":["mockingbird"],"지빠귀의무리":["ouzel"],"지상기지소속의":["landbased"],"지상군원호항공대":["umbrella"],"지상에사는것":["terrestrial"],"지상에서생긴":["terrigenous"],"지상에서자란":["earthbred"],"지선운항여객기":["feederliner"],"지언유언집행자":["executor"],"지역마다다른":["allopatric"],"지역적이아닌":["azonic"],"지엽으로흐름":["digression"],"지옥같은광경":["inferno"],"지옥에떨어뜨림":["damnation"],"지옥에떨어질":["damning"],"지옥에떨어짐":["perdiem"],"지울힘이없는":["obliterative"],"지저귀는소리":["tweet"],"지저귀듯노래하다":["warble"],"지적소화불량":["indigestion"],"지적으로하다":["intellectualize"],"지절거리는사람":["blab"],"지접복사사진":["photostat"],"지정되지않은":["undesignated"],"지정보호지역":["reserve"],"지정할수있는":["assignable"],"지조없는사람":["chameleon"],"지주계급의사람":["landocrat"],"지지않는기질의":["neversaydie"],"지지되지않은":["unsupported"],"지지러지게하다":["dwarf"],"지지않으려는":["emulative"],"지지하지않음":["nonsupport"],"지지할수없는":["unsupportable"],"지진의초기미동":["foreshock"],"지참금이없는":["fortuneless"],"지체가높은숙녀":["dame"],"지체높은사람":["gentleman"],"지쳐빠지게하다":["spend"],"지쳐버리게하다":["exhaust"],"지쳐버리지않은":["unexhausted"],"지쳐서초라해진":["battered"],"지층이단사의":["monoclinal"],"지치과풀의일종":["honeywort"],"지칠대로지친":["bonetired","whippedup"],"지칠줄모르는":["weariless","tireless","inexhaustible","unflagging"],"지칠줄모르는사람":["glutton"],"지켜야할의식":["observance"],"지켜지지않은":["unobserved"],"지키지못하는":["incontinent"],"지탱할수없는":["insupportable"],"지팡이멍청이":["stick"],"지퍼로잠그는":["zipup"],"지프로나르다":["jeep"],"지하유골안치소":["columbarium"],"지하출판활동가":["samizdatchik"],"지하폭발용폭약":["camouflet"],"지하도수터널":["qanat"],"지하도지하통로":["gallery"],"지하실담당자":["cellarman"],"지하실보관료":["cellarage"],"지하실출입구":["area"],"지하실에저정하다":["cella"],"지하실의평수":["cellarage"],"지하에서생성된":["hypogene"],"지하의신들의":["chthonic"],"지하저항운동"